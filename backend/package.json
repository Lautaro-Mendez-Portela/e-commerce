{
  "name": "ecommerce-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "docker:start": "prisma migrate deploy && node src/server.js",
    "docker:dev": "prisma migrate deploy && nodemon --legacy-watch src/server.js",
    "docker:test:integration": "prisma migrate deploy && vitest run --coverage tests/unit tests/integration tests/services tests/webhook tests/admin",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration tests/services tests/webhook tests/admin",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "node --check src/app.js && node --check src/server.js && node --check src/services/stripe-webhook.service.js && node --check src/services/payment.service.js && node --check src/docs/openapi.js && node --check src/docs/docs.routes.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^6.19.3",
    "stripe": "^22.1.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
